{
	"schemaVersion": 1,
	"id": "extendedslabs",
	"version": "${modVersion}",
	"name": "${modName}",
	"description": "${modDescription}",
	"authors": ["${modAuthor}"],
	"license": "${modLicense}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.blackout.extendedslabs.loader.fabric.FabricEntrypoint"
		],
		"jei_mod_plugin": [
			"com.blackout.extendedslabs.compat.jei.ESJeiPlugin"
		]
	},
	"depends": {
		"fabricloader": ">=${fabricLoaderVersion}",
		"fabric-api": ">=${fabricApiVersion}",
		"minecraft": "${minecraftVersion}",
		"java": ">=25"
	},
	"suggests": {
		"jei": ">=${jeiVersion}"
	}
}
